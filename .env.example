# ==============================================================================
# SiHadir-Edu: Environment Variables Template (.env.example)
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL - 100% Free Tier 500MB)
# ------------------------------------------------------------------------------
# Pooled connection via Supabase PgBouncer (Port 6543) for Server Actions & API routes
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (Port 5432) required by Prisma CLI for migrations and db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS & STORAGE (Free Tier 1GB Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service-role-key-placeholder"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA PIPELINE (Alternative Free Tier 25GB Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="sihadiredu-demo"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz_secret"

# ------------------------------------------------------------------------------
# 4. WHATSAPP NOTIFICATION GATEWAY (Fonnte / Wablas with Anti-Ban Protection)
# ------------------------------------------------------------------------------
WA_GATEWAY_PROVIDER="FONNTE"
WA_GATEWAY_API_URL="https://api.fonnte.com/send"
WA_GATEWAY_TOKEN="fonnte-device-token-placeholder"

# Optional provider-specific aliases
FONNTE_API_TOKEN="fonnte-device-token-placeholder"
WABLAS_API_TOKEN="wablas-token-placeholder"

# Set true if normal on-time arrival sends instant WA; set false to batch or skip (recommended: false to prevent Meta bans)
WA_ENABLE_INSTANT_NORMAL_ATTENDANCE="false"

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & CRYPTOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="kunci-rahasia-panjang-acak-untuk-session-jwt-32char"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# HMAC-SHA256 Secret for Student QR Card Tokens (format: SHD.<student_id>.<signature>)
QR_SIGNING_SECRET="kunci-rahasia-penandatangan-kartu-qr-siswa-2026"

# ------------------------------------------------------------------------------
# 6. SCHOOL OPERATIONAL PARAMETERS & HARDWARE SCANNER DEFAULTS
# ------------------------------------------------------------------------------
SCHOOL_NAME="SMA Harapan Bangsa"

# Morning gate late arrival cutoff (WIB format HH:mm)
GATE_LATE_THRESHOLD="07:15"

# Afternoon gate departure check-out start time (WIB format HH:mm)
GATE_CHECKOUT_START="13:30"

# Anti-double scan cooldown in seconds (300 seconds = 5 minutes)
SCAN_COOLDOWN_SECONDS=300

# Client-side image compression constraints for learning documentation
MAX_IMAGE_SIZE_KB=180
MAX_IMAGE_DIMENSION_PX=1280
