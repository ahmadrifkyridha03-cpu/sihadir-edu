# ==============================================================================
# SiHadir-Edu: Comprehensive .gitignore
# Stack: Next.js (App Router), TypeScript, Tailwind CSS, Prisma, Supabase
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 2. Next.js & Build Artifacts
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.cache/
.parcel-cache/

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env*
*.pem
*.key
*.cert
*.crt

# Explicitly track environment template
!.env.example

# ------------------------------------------------------------------------------
# 4. Supabase & Database Local Artifacts
# ------------------------------------------------------------------------------
.supabase/
supabase/.temp/
supabase/.branches/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Explicitly ensure Prisma migrations and schema are tracked
!prisma/migrations/
!prisma/schema.prisma
!prisma/seed.ts

# ------------------------------------------------------------------------------
# 5. TypeScript & Diagnostic Caches
# ------------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# 6. Teamwork & Multi-Agent Metadata (DO NOT COMMIT)
# ------------------------------------------------------------------------------
.agents/
.gemini/

# ------------------------------------------------------------------------------
# 7. Knowledge Graph (graphify) Caches
# ------------------------------------------------------------------------------
graphify-out/cache/
graphify-out/**/cache/
graphify-out/.graphify_*
graphify-out/*.tmp

# Explicitly ensure knowledge graph output deliverables are tracked
!graphify-out/graph.json
!graphify-out/graph.html
!graphify-out/GRAPH_REPORT.md

# ------------------------------------------------------------------------------
# 8. Test Coverage & Automation Artifacts
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 9. IDE & Editor Artifacts
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 10. Operating System Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
